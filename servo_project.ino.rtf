#include <Servo.h>

Servo servo1; 
Servo servo2;  

int pos = 0;

void setup() {
  servo1.attach(9);  
  servo2.attach(10); 
}

void loop() {
  for (pos = 0; pos <= 180; pos += 1) {
    servo1.write(pos);     
    servo2.write(180 - pos);   
    delay(15);
  }

  for (pos = 180; pos >= 0; pos -= 1) {
    servo1.write(pos);       
    servo2.write(180 - pos);  
    delay(15);
  }
}
